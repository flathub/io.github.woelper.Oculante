{
  "app-id": "io.github.woelper.Oculante",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "26.08",
  "sdk": "org.freedesktop.Sdk",
  "sdk-extensions": ["org.freedesktop.Sdk.Extension.rust-stable"],
  "command": "oculante",
  "finish-args": [
    "--share=ipc",
    "--share=network",
    "--device=dri",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--filesystem=home"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin"
  },
  "modules": [
    {
      "name": "oculante",
      "buildsystem": "simple",
      "build-options": {
        "env": {
          "CARGO_HOME": "/run/build/oculante/cargo"
        }
      },
      "build-commands": [
        "cargo --offline fetch --locked --manifest-path Cargo.toml --verbose",
        "cargo --offline build --locked --release --verbose --no-default-features --features turbo,avif_native,notan/shaderc,j2k,jxlcms",
        "install -Dm644 ./res/flathub/$FLATPAK_ID.desktop /app/share/applications/$FLATPAK_ID.desktop",
        "install -Dm644 ./res/flathub/$FLATPAK_ID.metainfo.xml /app/share/metainfo/$FLATPAK_ID.metainfo.xml",
        "install -Dm644 ./res/icons/icon.png /app/share/icons/hicolor/256x256/apps/$FLATPAK_ID.png",
        "install -Dm755 ./target/release/oculante -t /app/bin/"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/woelper/oculante/archive/refs/tags/0.9.6.tar.gz",
          "sha256": "1add7a6cefeaba4df250f021dcde4bf101c8f930813624cd75e0510425898216"
        },
        {
          "type": "patch",
          "path": "appstream-releases.patch"
        },
        "cargo-sources.json",
        {
          "type": "patch",
          "path": "libaom-nasm-help.patch"
        }
      ]
    }
  ]
}
